# ---------------------------------------------------------------
# Clinicyza Server — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------

# ---- Database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=clinicyza

# ---- Auth (JWT) — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# ---- Cookies (web portals) — empty on localhost, e.g. .clinicyza.com in production
COOKIE_DOMAIN=

# ---- CORS: browser origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ---- Links used in emails
PORTALS_URL=http://localhost:3002
APP_NAME=Clinicyza

# ---- Logging & monitoring
LOG_LEVEL=info
# Store one ApiLog row per request (Admin › Logs › API)
API_LOG_ENABLED=true

# ---- Realtime (WebSocket) server — `npm run realtime`, runs locally only for now
REALTIME_PORT=8001
# URL browsers / apps connect to. Leave empty where no realtime server runs (e.g. Vercel today).
REALTIME_PUBLIC_URL=http://localhost:8001
# URL the API uses to broadcast events to the realtime server
REALTIME_INTERNAL_URL=http://localhost:8001
# Shared secret between the API and the realtime server (generate like the JWT secrets)
REALTIME_INTERNAL_SECRET=
REALTIME_TICKET_TTL_SECONDS=60

# ---- Background worker — `npm run worker`
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=4

# ---- Email (SMTP). Leave SMTP_HOST empty to print emails to the console.
# Local mail catcher: `brew install mailpit` → SMTP localhost:1025, inbox http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Clinicyza <no-reply@clinicyza.com>"
EMAIL_REPLY_TO=care@clinicyza.com

# ---- Later milestones (sandbox keys) — not used yet
# Video consultations (Daily.co)
DAILY_API_KEY=
DAILY_DOMAIN=
# Payments (Revolut Business Merchant API, sandbox)
REVOLUT_API_URL=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=
REVOLUT_PUBLIC_KEY=
REVOLUT_WEBHOOK_SECRET=
